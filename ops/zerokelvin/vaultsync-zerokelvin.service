[Unit]
Description=ZeroKelvin VaultSync daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rvp
Group=rvp
WorkingDirectory=/opt/vaultsync-zerokelvin
ExecStart=/usr/bin/node /opt/vaultsync-zerokelvin/bin/vsa.js --config /var/lib/vaultsync-zerokelvin/config.json daemon run
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
Environment=HOME=/var/lib/vaultsync-zerokelvin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/remote-vault/zerokelvin /var/lib/vaultsync-zerokelvin

[Install]
WantedBy=multi-user.target
