{
  "name": "vaultsyncforagents",
  "version": "0.1.4",
  "private": true,
  "description": "Self-hosted Obsidian vault sync engine (monorepo root)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:core && npm run test:node-runtime && npm run test:cli && npm run test:worker && npm run test:daemon && npm run test:dashboard && npm run test:plugin",
    "test:core": "vitest run",
    "test:node-runtime": "npm run test --workspace @vsa/node-runtime",
    "test:cli": "npm run test --workspace vaultsyncforagents",
    "test:worker": "npm run test --workspace @vsa/worker",
    "test:daemon": "npm run test --workspace @vsa/daemon",
    "test:dashboard": "npm run test --workspace @vsa/dashboard",
    "test:plugin": "npm run test --workspace @vsa/plugin",
    "build:dashboard": "npm run build --workspace @vsa/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "vsa": "node packages/cli/bin/vsa.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
