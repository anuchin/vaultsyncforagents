// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`naming and config generation > renderWranglerConfig: mirrors the worker bindings (snapshot) 1`] = `
"{
  // Generated by \`vsa setup\` — VaultSync for Agents, one worker per vault
  // (ARCHITECTURE.md §1, FR-20). Deployed from the v0.1.2 release bundle.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaultsync-personal-x7q2",
  "main": "./dist/worker.js",
  "compatibility_date": "2026-08-01",
  // Dashboard SPA shipped inside the release bundle (dist/dashboard), served
  // by the worker at / — no second deployment (ARCHITECTURE.md §10).
  "assets": {
    "directory": "./dist/dashboard",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "VaultRoom"
      }
    ]
  },
  // SQLite-backed Durable Object class registration (wrangler schema has no
  // top-level new_sqlite_classes key — it lives under migrations).
  "migrations": [
    {
      "tag": "0001_initial",
      "new_sqlite_classes": ["VaultRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "vaultsync-personal-x7q2"
    }
  ],
  "triggers": {
    // Weekly orphan-blob GC, Mondays 03:00 UTC (ARCHITECTURE.md §7).
    "crons": ["0 3 * * 1"]
  }
}
"
`;
