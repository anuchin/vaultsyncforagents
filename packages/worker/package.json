{
  "name": "@vsa/worker",
  "version": "0.1.4",
  "private": true,
  "description": "VaultSync for Agents Cloudflare Worker: VaultRoom Durable Object, blob routes, claim/pairing, GC cron",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build:dashboard && wrangler dev",
    "deploy": "npm run build:dashboard && wrangler deploy",
    "build:dashboard": "npm run build --workspace @vsa/dashboard",
    "test": "vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@vsa/core": "^0.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.2",
    "wrangler": "^4.124.0"
  }
}
